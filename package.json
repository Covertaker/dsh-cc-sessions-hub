{
  "name": "dsh-cc-sessions-hub",
  "version": "0.4.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "host/*.js",
    "scripts/*.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323"
  },
  "license": "MIT",
  "description": "Claude Code sessions hub for DeepSeek Harness: list, chat, approvals, previews, subagents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Covertaker/dsh-cc-sessions-hub.git"
  },
  "homepage": "https://github.com/Covertaker/dsh-cc-sessions-hub#readme",
  "bugs": {
    "url": "https://github.com/Covertaker/dsh-cc-sessions-hub/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "claude-code",
    "session",
    "plugin"
  ],
  "author": "Covertaker"
}
